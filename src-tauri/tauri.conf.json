{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-hunk",
  "version": "0.2.0",
  "identifier": "com.tauri-app.git-hunk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "git-hunk",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjE5QkEzODlCQzRBMDAKUldRQVNyeUpvNXZ4d3FTdlJwTmc2ZGJ1VGxiMUJoK1g0WU40Sjc2YUQ4T0loejVjaXh2eEwwOVMK",
      "endpoints": [
        "https://github.com/jpzuo/git-hunk/releases/latest/download/latest.json"
      ]
    }
  }
}
